# Cabeceras de seguridad que Netlify aplica a todas las páginas.
#
# La política de contenido (CSP) está en modo BLOQUEO. Todo el JavaScript vive
# en /js/ (script-src 'self', sin 'unsafe-inline'): un código inyectado en la
# página no se ejecuta.
# 'unsafe-inline' sigue solo en style-src porque las páginas usan atributos
# style="…"; un estilo inyectado no puede ejecutar código.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
